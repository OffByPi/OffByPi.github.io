{
  "name": "@offbypi/content-meta",
  "version": "1.0.0",
  "description": "ContentMeta component for Quartz - displays created/updated date and reading time",
  "type": "module",
  "license": "MIT",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "dependencies": {
    "@quartz-community/types": "github:quartz-community/types#d413569b02ff0cd9a7e8d74dee125d20a5e5ec72",
    "@quartz-community/utils": "github:quartz-community/utils#e09d8b0bbccb46073b23c00affaf3e40a2c3b0c4",
    "reading-time": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "preact": "^10.28.2",
    "sass": "^1.97.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "quartz": {
    "name": "content-meta",
    "displayName": "Content Meta",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {
      "showReadingTime": true,
      "showUpdated": true,
      "showComma": true
    },
    "components": {
      "ContentMeta": {
        "displayName": "Content Meta",
        "defaultPosition": "beforeBody",
        "defaultPriority": 20
      }
    },
    "optionSchema": {
      "showReadingTime": {
        "type": "boolean"
      },
      "showUpdated": {
        "type": "boolean"
      },
      "showComma": {
        "type": "boolean"
      }
    }
  }
}
